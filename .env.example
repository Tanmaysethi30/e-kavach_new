# ==============================================================================
# E-KAVACH Local Environment Configuration
# ==============================================================================
# The application works 100% out of the box with default zero-config local storage.
# Copy this file to `.env` to customize your local setup.

# Unified Server Port (Default: 3000)
PORT=3000

# Optional: Google Gemini API Key for AI-assisted clinical triage and document analysis
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Environment mode
NODE_ENV=development

# ==============================================================================
# Authentication & Encryption Secrets (OPTIONAL)
# ==============================================================================
# NOTE: These are NOT API keys from an external service!
# You do NOT need to purchase or register anywhere to get them.
# They are simply internal cryptographic secret passphrases that the server uses
# to sign session tokens (JWT) and prevent token forgery.
#
# If you leave these blank or omit them, the backend AUTOMATICALLY uses secure
# built-in default values. For production deployment, you can set any long random
# string (e.g., generated with `openssl rand -hex 32` or any random characters).
JWT_ACCESS_SECRET=ekavach_jwt_access_super_secret_key_32bytes_min_2026
JWT_REFRESH_SECRET=ekavach_jwt_refresh_super_secret_key_32bytes_min_2026
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

